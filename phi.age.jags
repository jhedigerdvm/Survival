
model {

#prior for recapture prob
p ~ dbeta(1, 1)


#priors
 
  lambda ~ dunif(0,5)
  gamma ~ dnorm(0,0.001)


# Likelihood
for (i in 1:nind){
   # Define latent state at first capture, we know for sure the animal is alive
      z[i,f[i]] <- 1

      for (t in (f[i]+1):h[i]){
      
        #Gompertz Hazard
            hazard[i,t-1] <- lambda * exp(-gamma*ageclass[i, t-1])
        # State process
            z[i,t] ~ dbern(mu1[i,t]) #toss of a coin whether individual is alive or not detected
            mu1[i,t] <- phi[i,t-1] * z[i,t-1]  #t-1 because we are looking ahead to see if they survived from 1 to 2 based upon them being alive at 2
            phi[i,t-1] <-  exp(-hazard[i, t-1])
            

          # Observation process
            ch[i,t] ~ dbern(mu2[i,t])
            mu2[i,t] <- p * z[i,t]



      } #t
   } #i

   #derived parameters

          for (j in 1:15) { #age
            phi.age[j] <- exp(-(lambda * exp(-gamma*age.sim[j])))

          }
          
          for (j in 2:15) {
            phi_diff[j] <- phi.age[j] - phi.age[j-1]
          
          }
          # phi_diff_1 <- phi.age[35]-phi.age[1]
          # phi_diff_2 <- phi.age[50]-phi.age[40]
          # phi_diff_3 <- phi.age[75]-phi.age[50]
          # phi_diff_4 <- phi.age[100]-phi.age[75]

          
          age_decline <- log(lambda) / gamma

      

}

