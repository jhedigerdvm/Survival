
model {

  p ~ dbeta(1,1)

  int   ~ dnorm(0,0.001)
  beta1 ~ dnorm(0,0.001)
  beta2 ~ dnorm(0,0.001)

  for(i in 1:nind){

    z[i,f[i]] <- 1

    for(t in (f[i]+1):h[i]){

      z[i,t] ~ dbern(mu1[i,t])

      mu1[i,t] <- phi[i,t-1] * z[i,t-1]

      logit(phi[i,t-1]) <-
           int
         + beta1*ageclass[i,t-1]
         + beta2*age.old[i,t-1]

      ch[i,t] ~ dbern(mu2[i,t])

      mu2[i,t] <- p*z[i,t]

    }

  }

}

